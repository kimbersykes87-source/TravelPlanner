# Travel Planner v2 – environment variables
# Copy to .env.local for local development
# For Cloudflare Pages: set in Dashboard → Settings → Environment variables

# Supabase (required for data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Password gate (production only – if using env-based password)
# VITE_APP_PASSWORD=your-secret-password
